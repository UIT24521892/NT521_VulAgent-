# VulAgent — mẫu biến môi trường. Copy thành .env (đã gitignore) và điền key RIÊNG.
# TUYỆT ĐỐI không commit .env. Không dùng key nhúng cứng trong repo gốc.

# VULAGENT_MODEL áp dụng cho provider đang chạy (đặt theo backend bạn chọn ở dưới).

# ── Backend A: Qwen qua DashScope (ĐÚNG model paper → dùng cho reproduction) ──
# Free quota chỉ ở region Singapore → đổi base_url sang endpoint quốc tế:
#   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VULAGENT_MODEL=qwen3-235b-a22b-instruct-2507

# ── Backend B: Claude qua API Anthropic (thí nghiệm backend KHÁC, không phải paper) ──
# Lấy key sau khi Claim $100 credit tại https://clau.de/api-credits (Console Anthropic).
# Chạy: scripts/run_pipeline.py --backend api --provider anthropic --confirm-paid --ids 71 ...
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=            # để trống = endpoint mặc định
VULAGENT_EFFORT=low             # low/medium/high/xhigh/max — low để tiết kiệm token
# Chọn model Claude (ước chi phí 1 lượt CẢ 2 tập ~28.5M input + 6.9M output, chưa cache):
#   claude-haiku-5-5   ($0.10/$0.50)  ≈ $6    ← vừa $100, chạy nhiều lượt
#   claude-sonnet-5-5  ($2/$10)       ≈ $126  ← hơi quá $100 cho 1 lượt
#   claude-opus-5-5    ($4/$20)       ≈ $251  ← vượt $100
VULAGENT_MODEL=claude-haiku-5-5

# Baseline GPT-4o (tùy chọn, khi chạy so sánh)
OPENAI_API_KEY=
OPENAI_BASE_URL=
